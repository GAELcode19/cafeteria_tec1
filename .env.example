# Copia este archivo a .env.local y ajusta los valores.

# --- MySQL ---------------------------------------------------------
# Servidor: MySQL 9.7 local (puerto 3306). Prepara todo con sql/setup.sql.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cafeteria
DB_PASSWORD=
DB_NAME=cafeteria_tec
# Base solo para pruebas unitarias; se VACÍA en cada corrida (debe contener "test").
DB_TEST_NAME=cafeteria_test

# --- Administrador inicial -----------------------------------------
# Se crea al primer arranque si no existe ningún admin.
# Solo para desarrollo: en producción usa una contraseña de 8+ caracteres.
ADMIN_EMAIL=admin@cafeteria.local
ADMIN_PASSWORD=1234

# Opcional: restringe el registro a un dominio (ej. tec.mx). Vacío = cualquiera.
ALLOWED_EMAIL_DOMAIN=
